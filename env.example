# Copiá este archivo como ".env" y completá con tus valores reales.
# En el hosting (Render, Railway, etc.) estas se cargan como "Environment Variables",
# no hace falta subir el archivo .env.

# API key de Anthropic (la sacás de console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ID de tu Google Sheet de ventas.
# Lo sacás de la URL: https://docs.google.com/spreadsheets/d/ESTE_ID/edit
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# GID de la pestaña con los datos (0 si es la primera pestaña de la planilla)
GOOGLE_SHEET_GID=0

# Estas dos las usás sólo si en el futuro querés enviar mensajes salientes
# por la API REST de Twilio en vez de la respuesta directa del webhook.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
